{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "StockDash: Start local server",
      "type": "shell",
      "command": "python",
      "args": ["launch.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "StockDash: Run tests",
      "type": "shell",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-p", "test_*.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    }
  ]
}
